# Copy to .env for local development
# Never commit .env to git

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production

# Comma-separated username:password pairs
# Add friends: USERS="you:yourpass,friend1:theirpass,friend2:theirpass"
USERS="admin:picks2026"

# StatMuse credentials — app logs in automatically on startup
STATMUSE_EMAIL="your@email.com"
STATMUSE_PASSWORD="yourpassword"

# Port (Render sets this automatically)
PORT=8000
